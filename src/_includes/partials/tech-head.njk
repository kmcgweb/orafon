{#- Shared header for Technical Center pages. Needs: lang, T, D, techTab ("overview"|"retrofit"|"documents"|"articles"), techTitle, techLead -#}
{%- from "partials/macros.njk" import icon -%}
{%- set tabs = [
  ["retrofit", "/retrofit/", T.retrofit, "cube"],
  ["articles", "/articles/", T.articles, "list"]
] -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb">
  <a href="{{ '/' | u(lang) }}">{{ T.home }}</a><span>›</span>
  {{ techTitle }}
</nav></div>
<section class="tech-hero"><div class="container">
  <div class="tech-band{% if techTab == 'retrofit' %} tb-nature{% endif %}">
    <div class="tb-glow tb1"></div><div class="tb-glow tb2"></div>
    <div class="tb-inner">
      <span class="tb-kicker">{{ icon("flask") }} {{ T.technical }}</span>
      <h1 class="display">{{ techTitle }}</h1>
      <p>{{ techLead }}</p>
    </div>
  </div>
  <nav class="tech-tabs" aria-label="{{ T.technical }}">
    {%- for t in tabs %}
    <a href="{{ t[1] | u(lang) }}"{% if techTab == t[0] %} class="active" aria-current="page"{% endif %}>{{ icon(t[3]) }}<span>{{ t[2] }}</span></a>
    {%- endfor %}
  </nav>
</div></section>
