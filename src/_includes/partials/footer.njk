{%- from "partials/macros.njk" import icon -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set S = D.site -%}
<footer class="site">
  <div class="ft-band">
    <div class="ft-peng" aria-hidden="true"></div>
    <div class="ft-wrap ft-band-in">
      <div>
        <p class="ft-promo">WE SERVE YOU BEST</p>
        <p class="ft-band-sub">{{ T.footBand }}</p>
      </div>
      <div class="ft-btns">
        {%- if S.phone %}<a class="ft-btn ft-btn-w" href="tel:{{ S.phone }}">{{ icon("phone") }}{{ S.phone_display }}</a>{% endif %}
        {%- if S.line_id %}<a class="ft-btn ft-btn-line" href="https://line.me/R/ti/p/{{ S.line_id | urlencode }}" target="_blank" rel="noopener">{{ icon("chat") }}LINE {{ S.line_id }}</a>{% endif %}
        <a class="ft-btn ft-btn-o" href="{{ '/contact/' | u(lang) }}">{{ T.requestQuote }}</a>
      </div>
    </div>
  </div>

  <div class="ft-wrap ft-main">
    <div class="ft-brand">
      <a href="{{ '/' | u(lang) }}" aria-label="{{ S.brand_name }}"><img src="/assets/img/orafon-logo.png" alt="{{ S.brand_name }}" width="160" height="47" loading="lazy"></a>
      <p>{{ S.footer_about }}</p>
    </div>
    <div class="ft-col">
      <h4>Products</h4>
      <ul>
        <li><a href="{{ '/products/' | u(lang) }}">{{ T.allProducts }}</a></li>
        {%- for b in D.brands %}<li><a href="{{ ('/brands/' ~ b.slug ~ '/') | u(lang) }}">{{ b.name }}</a></li>{% endfor %}
        {%- for p in D.featured | batch(3) | first %}<li><a href="{{ ('/products/' ~ p.slug ~ '/') | u(lang) }}">{{ p.name }}</a></li>{% endfor %}
      </ul>
    </div>
    <div class="ft-col">
      <h4>Technical Center</h4>
      <ul>
        <li><a href="{{ '/technical/' | u(lang) }}">{{ T.techOverview }}</a></li>
        <li><a href="{{ '/retrofit/' | u(lang) }}">{{ T.retrofit }}</a></li>
        <li><a href="{{ '/documents/' | u(lang) }}">{{ T.documents }}</a></li>
        <li><a href="{{ '/articles/' | u(lang) }}">{{ T.articles }}</a></li>
      </ul>
    </div>
    <div class="ft-col">
      <h4>Company</h4>
      <ul>
        <li><a href="{{ '/about/' | u(lang) }}">{{ T.about }}</a></li>
        <li><a href="{{ '/contact/' | u(lang) }}">{{ T.requestQuote }}</a></li>
        <li><a href="{{ '/privacy/' | u(lang) }}">{{ T.privacy }}</a></li>
        <li><a href="{{ '/terms/' | u(lang) }}">{{ T.terms }}</a></li>
      </ul>
    </div>
    <div class="ft-col ft-contact">
      <h4>Contact</h4>
      <ul>
        {%- if S.email %}<li>{{ icon("mail") }}<a href="mailto:{{ S.email }}">{{ S.email }}</a></li>{% endif %}
        {%- if S.address %}<li>{{ icon("pin") }}<span>{{ S.company_name }}<br>{{ S.address }}</span></li>{% endif %}
        {%- if S.hours %}<li>{{ icon("clock") }}<span>{{ S.hours }}</span></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="ft-bot">
    <div class="ft-wrap">
      <span>© {{ buildYear }} {{ S.company_name }} · {{ T.rights }}</span>
      <nav><a href="{{ '/privacy/' | u(lang) }}">{{ T.privacy }}</a><a href="{{ '/terms/' | u(lang) }}">{{ T.terms }}</a></nav>
    </div>
  </div>
</footer>
