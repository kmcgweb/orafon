{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set S = D.site -%}
{%- set pageTitle = (title ~ " — " ~ S.brand_name) if title else (S.brand_name ~ " — " ~ S.tagline) -%}
{%- set pageDesc = description or S.tagline -%}
{%- set canonical = (pathKey | u(lang)) | absUrl(S.site_url) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ canonical }}">
{%- for l in langs %}
<link rel="alternate" hreflang="{{ l }}" href="{{ (pathKey | u(l)) | absUrl(S.site_url) }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ pathKey | absUrl(S.site_url) }}">
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ S.brand_name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ (ogImage or '/assets/img/orafon-logo.png') | absUrl(S.site_url) }}">
<meta property="og:locale" content="{{ 'th_TH' if lang == 'th' else 'en_US' }}">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/orafon.css">
{%- if extraCss %}
<link rel="stylesheet" href="/assets/css/{{ extraCss }}">
{%- endif %}
{%- if jsonLd %}
<script type="application/ld+json">{{ jsonLd | safe }}</script>
{%- endif %}
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#main">{{ T.skipToContent }}</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{%- from "partials/macros.njk" import icon %}
<div class="fab">
  <button class="fab-top" type="button" id="toTop" aria-label="{{ T.backToTop }}" hidden>{{ icon("chev") }}</button>
  {%- if S.phone %}<a class="fab-phone" href="tel:{{ S.phone }}" aria-label="{{ T.call }} {{ S.phone_display }}">{{ icon("phone") }}</a>{% endif %}
  {%- if S.line_id %}<a class="fab-line" href="https://line.me/R/ti/p/{{ S.line_id | urlencode }}" target="_blank" rel="noopener" aria-label="LINE {{ S.line_id }}">{{ icon("chat") }}</a>{% endif %}
</div>
<script src="/assets/js/cart.js" defer></script>
<script src="/assets/js/nav.js" defer></script>
{%- if pageScript %}
<script src="/assets/js/{{ pageScript }}" defer></script>
{%- endif %}
</body>
</html>
