---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/articles/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /articles/
section: articles
eleventyComputed:
  title: "{{ i18n[lang].articles }}"
  description: "{{ i18n[lang].articlesLead }}"
---
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb"><a href="{{ '/' | u(lang) }}">{{ D.site.brand_name }}</a><span>›</span>{{ T.articles }}</nav></div>
<section class="page-head"><div class="container">
  <h1 class="display">{{ T.articles }}</h1>
  <p>{{ T.articlesLead }}</p>
</div></section>
<section class="section" style="padding-top:24px"><div class="container">
  <div class="art-grid">
    {%- for a in D.articles %}
    <a class="art-card" href="{{ ('/articles/' ~ a.slug ~ '/') | u(lang) }}">
      <div class="cover">{% if a.cover %}<img src="{{ a.cover }}" alt="" loading="lazy">{% endif %}</div>
      <div class="b"><time datetime="{{ a.date | isoDate }}">{{ a.date | dateFmt(lang) }}</time><h3>{{ a.title }}</h3><p>{{ a.excerpt }}</p></div>
    </a>
    {%- else %}
    <div class="card empty">{{ T.noArticles }}</div>
    {%- endfor %}
  </div>
</div></section>
