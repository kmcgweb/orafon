---
pagination: { data: articlePages, size: 1, alias: entry }
permalink: "{{ ('/articles/' ~ entry.item.slug ~ '/') | u(entry.lang) }}"
layout: layouts/base.njk
section: articles
eleventyComputed:
  lang: "{{ entry.lang }}"
  pathKey: "/articles/{{ entry.item.slug }}/"
  title: "{{ entry.item.title }}"
  description: "{{ entry.item.excerpt }}"
  ogImage: "{{ entry.item.cover or '' }}"
---
{%- from "partials/macros.njk" import ctaBand -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set a = entry.item -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb">
  <a href="{{ '/' | u(lang) }}">{{ D.site.brand_name }}</a><span>›</span>
  <a href="{{ '/articles/' | u(lang) }}">{{ T.articles }}</a><span>›</span>{{ a.title }}
</nav></div>
<article class="section" style="padding-top:24px"><div class="container" style="max-width:860px">
  <time class="muted" datetime="{{ a.date | isoDate }}">{{ a.date | dateFmt(lang) }}</time>
  <h1 class="display" style="font-size:36px;font-weight:800;margin:8px 0 20px">{{ a.title }}</h1>
  {%- if a.cover %}<img src="{{ a.cover }}" alt="" style="border-radius:20px;margin-bottom:24px;width:100%">{% endif %}
  <div class="prose">{{ a.body | md | safe }}</div>
</div></article>
<section class="section" style="padding-top:0"><div class="container">
  {{ ctaBand(lang, T, D.site, D.home.cta_title, D.home.cta_text) }}
</div></section>
