---
pagination: { data: productPages, size: 1, alias: entry }
permalink: "{{ ('/products/' ~ entry.item.slug ~ '/') | u(entry.lang) }}"
layout: layouts/base.njk
section: products
extraCss: product.css
pageScript: product.js
bodyClass: has-sticky
eleventyComputed:
  lang: "{{ entry.lang }}"
  pathKey: "/products/{{ entry.item.slug }}/"
  title: "{{ entry.item.name }}"
  description: "{{ entry.item.seo_description or entry.item.short }}"
  ogImage: "{{ entry.item.coverImage }}"
---
{%- from "partials/macros.njk" import icon, cylinder, productCard -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set S = D.site -%}
{%- set p = entry.item -%}
{%- set r = p.ref -%}
{%- set b = p.brandObj -%}
{%- set apps = p.applications if (p.applications and p.applications.length) else (r.applications if r else []) -%}
{%- set hlIcons = ["gwp", "bolt", "shield", "cube", "grid", "doc"] -%}
{%- set contactUrl = '/contact/' | u(lang) -%}

{%- set lowGwp = r and (r.gwp_ar4 | int) < 150 -%}
{%- set rel = [] -%}
{%- for o in D.products %}{% if o.slug != p.slug and p.kind and o.kind == p.kind and rel.length < 4 %}{% set _ = rel.push(o) %}{% endif %}{% endfor -%}
{%- for o in D.products %}{% if o.slug != p.slug and rel.indexOf(o) < 0 and o.brand == p.brand and rel.length < 4 %}{% set _ = rel.push(o) %}{% endif %}{% endfor -%}

<div class="container pd-crumbs">
  <nav class="breadcrumb" aria-label="breadcrumb">
    <a href="{{ '/' | u(lang) }}">{{ T.home }}</a><span>›</span>
    <a href="{{ '/products/' | u(lang) }}">{{ T.allProducts }}</a><span>›</span>
    {%- if b %}<a href="{{ ('/brands/' ~ b.slug ~ '/') | u(lang) }}">{{ b.name }}</a><span>›</span>{% endif %}
    {{ p.name }}
  </nav>
</div>

<div class="container pd" id="product" style="--c:{{ p.tankColor }}"
     data-name="{{ p.name }}" data-line="{{ S.line_id }}" data-contact="{{ contactUrl }}" data-linemsg="{{ T.lineMsg }}">

  {#- ===== left: sticky section menu ===== -#}
  <aside class="pd-side" aria-label="{{ T.onThisPage }}">
    <div class="pd-side-top">
      <a href="#pd-top" class="pd-side-link is-top">{{ T.tabDesc }}</a>
      <a class="pd-side-quote js-quote" href="{{ contactUrl }}?product={{ p.name | urlencode }}">{{ icon("doc") }}{{ T.quoteShort }}</a>
    </div>
    <a href="#pd-quote" class="pd-side-link">{{ T.packages }}</a>
    {%- if r or (p.specs and p.specs.length) %}<a href="#pd-specs" class="pd-side-link" data-open>{{ T.tabSpecs }}</a>{% endif %}
    <a href="#pd-docs" class="pd-side-link" data-open>{{ T.docsTitle }}</a>
    {%- if apps.length %}<a href="#pd-apps" class="pd-side-link" data-open>{{ T.applications }}</a>{% endif %}
    {%- if p.faq and p.faq.length %}<a href="#pd-faq" class="pd-side-link" data-open>{{ T.tabFaq }}</a>{% endif %}
    {%- if rel.length %}<a href="#pd-related" class="pd-side-link">{{ T.relatedProducts }}</a>{% endif %}
  </aside>

  <div class="pd-main">
    {#- ===== hero: gallery + summary ===== -#}
    <section class="pd-hero" id="pd-top">
      <div class="gallery">
        <div class="main-wrap"><div class="main-img">
          {%- if p.brandObj and p.brandObj.logo %}<span class="pd-logo" style="background-image:url('{{ p.brandObj.logo }}')" role="img" aria-label="{{ p.brandObj.name }}"></span>{% endif %}
          {%- if p.coverImage %}<button class="gal-open" type="button" aria-label="{{ T.zoomImg }}"><img id="mainImg" src="{{ p.coverImage }}" alt="{{ p.name }}"><span class="gal-zoom" aria-hidden="true">{{ icon("search") }}</span></button>{% else %}{{ cylinder(r, "main") }}{% endif %}
          {%- if p.gallery.length > 1 %}
          <button class="gal-nav gal-prev" type="button" aria-label="{{ T.prevImg }}">{{ icon("chev") }}</button>
          <button class="gal-nav gal-next" type="button" aria-label="{{ T.nextImg }}">{{ icon("chev") }}</button>
          <span class="gal-count"><b id="galIdx">1</b> / {{ p.gallery.length }}</span>
          {%- endif %}
        </div></div>
        {%- if p.gallery.length > 1 %}
        <div class="thumbs">
          {%- for img in p.gallery %}
          <button class="thumb{% if loop.first %} active{% endif %}" type="button" data-src="{{ img }}" aria-label="{{ p.name }} {{ loop.index }}"><img src="{{ img }}" alt="" loading="lazy"></button>
          {%- endfor %}
        </div>
        {%- endif %}
        {%- if p.coverImage %}
        <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="{{ p.name }}">
          <button class="lb-close" type="button" aria-label="{{ T.close }}">✕</button>
          {%- if p.gallery.length > 1 %}<button class="lb-nav lb-prev" type="button" aria-label="{{ T.prevImg }}">{{ icon("chev") }}</button><button class="lb-nav lb-next" type="button" aria-label="{{ T.nextImg }}">{{ icon("chev") }}</button>{% endif %}
          <img id="lbImg" src="{{ p.coverImage }}" alt="{{ p.name }}">
          {%- if p.gallery.length > 1 %}<span class="lb-count"><b id="lbIdx">1</b> / {{ p.gallery.length }}</span>{% endif %}
        </div>
        {%- endif %}
      </div>

      <div class="pd-info">
        <h1 class="pd-title">{% if r and r.number and r.number in p.name %}{{ (p.name | escape | string) | replace(r.number, "<span class=\"pc-ref\">" ~ r.number ~ "</span>") | safe }}{% else %}{{ p.name }}{% endif %}</h1>
        <div class="pd-chips">
          {%- if r %}<span class="pd-chip is-fill">{{ r.class }}</span><span class="pd-chip">{{ r.number }}</span><span class="pd-chip sf sf-{{ r.safety }}">{{ r.safety }}</span>{% else %}<span class="pd-chip is-fill">{{ T.cats[p.category] }}</span>{% if p.oilType %}<span class="pd-chip">{{ p.oilType }}</span>{% endif %}{% endif %}
          {%- for l in p.labels %}<span class="prod-tag lb-{{ l }}">{{ T.labels[l] }}</span>{% endfor %}
        </div>
        <div class="pd-iconrow">
          {%- set seenIc = [] %}
          {%- for a in apps %}{% if a.icon_image or seenIc.indexOf(a.icon) < 0 %}{% set _ = seenIc.push(a.icon) %}<span class="pd-ic" title="{{ a.label }}"><img src="{{ a.icon_image or ('/assets/img/icons/' ~ (a.icon or 'snow') ~ '.svg') }}" alt="{{ a.label }}" width="30" height="30"></span>{% endif %}{% endfor %}
          {%- if lowGwp %}<span class="pd-eco" title="{{ T.lowGwp }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/></svg>{{ T.lowGwp }}</span>{% endif %}
        </div>
        {%- if p.tagline %}<p class="pd-tagline">{{ p.tagline }}</p>{% endif %}
        {%- if p.short %}<p class="pd-short">{{ p.short }}</p>{% endif %}
        {%- if r %}
        <dl class="pd-specs">
          <div><dt>GWP</dt><dd>{{ r.gwp_ar4 or "—" }}</dd></div>
          <div><dt>ODP</dt><dd>{{ r.odp or "—" }}</dd></div>
          <div><dt>ASHRAE</dt><dd>{{ r.safety or "—" }}</dd></div>
          {%- if r.replaces and r.replaces.length %}<div><dt>{{ T.replaces }}</dt><dd>{{ r.replaces | join(", ") }}</dd></div>{% endif %}
        </dl>
        {%- elif p.specs and p.specs.length %}
        <dl class="pd-specs">
          {%- for sp in p.specs | batch(4) | first %}<div><dt>{{ sp.k }}</dt><dd>{{ sp.v }}</dd></div>{% endfor %}
        </dl>
        {%- endif %}
        {%- if b %}<p class="pd-brand">{% if b.logo %}<img src="{{ b.logo }}" alt="{{ b.name }}" height="22">{% endif %}<span>{{ b.name }}{% if not b.own_brand %} · {{ T.distributedBy }} {{ S.brand_name }}{% endif %}</span></p>{% endif %}
      </div>
    </section>

    {#- ===== quotation: pack size + quantity ===== -#}
    <section class="pd-quote" id="pd-quote">
      <h2>{{ T.selectForQuote }}</h2>
      {%- if p.packages and p.packages.length %}
      <div class="pd-packs" id="pkgOpts" role="radiogroup" aria-label="{{ T.packages }}">
        {%- for k in p.packages %}
        <button type="button" class="pkg-opt{% if loop.first %} active{% endif %}" role="radio" aria-checked="{{ 'true' if loop.first else 'false' }}" aria-pressed="{{ 'true' if loop.first else 'false' }}"
                data-label="{{ k.name }} — {{ k.kg | kg }} {{ k.unit or "kg" }}{% if k.sku %} (SKU {{ k.sku }}){% endif %}{% if k.special %} ({{ T.specialOrder }}){% endif %}">
          <span class="pk-radio" aria-hidden="true"></span>
          <span class="pk-txt"><span class="name">{{ k.name }}</span><span class="kg">{{ k.kg | kg }} {{ k.unit or "kg" }}</span>{% if k.sku %}<span class="meta">SKU {{ k.sku }}</span>{% endif %}{% if k.special %}<span class="pk-special">{{ T.specialOrder }}</span>{% endif %}</span>
        </button>
        {%- endfor %}
      </div>
      {%- else %}
      <p class="muted">{{ T.askSizes }}</p>
      {%- endif %}
      <div class="pd-buy">
        <div class="pd-qty" role="group" aria-label="{{ T.qty }}">
          <button type="button" data-qty="-1" aria-label="−">−</button>
          <input id="qty" type="number" inputmode="numeric" min="1" max="999" value="1" aria-label="{{ T.qty }}">
          <button type="button" data-qty="1" aria-label="+">+</button>
        </div>
        <a class="btn btn-primary js-quote" href="{{ contactUrl }}?product={{ p.name | urlencode }}">{{ icon("doc") }} {{ T.requestQuote }}</a>
        {%- if S.line_id %}<a class="btn btn-line js-line" href="https://line.me/R/ti/p/{{ S.line_id | urlencode }}" target="_blank" rel="noopener">{{ icon("chat") }} {{ T.askLine }}</a>{% endif %}
        {%- if S.phone %}<a class="btn btn-ghost" href="tel:{{ S.phone }}">{{ icon("phone") }} {{ S.phone_display }}</a>{% endif %}
      </div>
      <p class="pd-note">{{ T.quoteNote }}</p>
    </section>

    {#- ===== accordions ===== -#}
    <div class="pd-acc">
      {%- if p.description or (p.highlights and p.highlights.length) %}
      <details id="pd-desc">
        <summary><h2>{{ T.tabDesc }}</h2><span class="chev">{{ icon("chev") }}</span></summary>
        <div class="pd-acc-body">
          {%- if p.highlights and p.highlights.length %}
          <div class="hl-grid">
            {%- for h in p.highlights %}<div class="hl"><span class="ic">{{ icon(hlIcons[loop.index0 % 6]) }}</span><div><h5>{{ h.title }}</h5><p>{{ h.text }}</p></div></div>{% endfor %}
          </div>
          {%- endif %}
          {%- if p.description %}<div class="prose">{{ p.description | md | safe }}</div>{% endif %}
        </div>
      </details>
      {%- endif %}

      {%- if r or (p.specs and p.specs.length) %}
      <details id="pd-specs">
        <summary><h2>{{ T.tabSpecs }}</h2><span class="chev">{{ icon("chev") }}</span></summary>
        <div class="pd-acc-body">
          <table class="spec-table"><tbody>
            {%- if b %}<tr><th>{{ T.brand }}</th><td>{{ b.name }}</td></tr>{% endif %}
            <tr><th>{{ T.distributedBy }}</th><td>{{ S.company_name }} ({{ S.brand_name }})</td></tr>
            <tr><th>{{ T.category }}</th><td>{{ T.cats[p.category] }}</td></tr>
            {%- if r %}
            <tr><th>{{ T.ashrae }}</th><td>{{ r.number }}</td></tr>
            <tr><th>{{ T.refType }}</th><td>{{ r.class }}</td></tr>
            {%- if r.blend_type %}<tr><th>{{ T.blendType }}</th><td>{{ T.blend[r.blend_type] or r.blend_type }}</td></tr>{% endif %}
            {%- if r.composition %}<tr><th>{{ T.composition }}</th><td>{{ r.composition }}</td></tr>{% endif %}
            <tr><th>{{ T.safety }}</th><td>{{ T.safetyText[r.safety] or r.safety }}</td></tr>
            <tr><th>{{ T.odp }}</th><td>{{ r.odp }}</td></tr>
            <tr><th>{{ T.gwp }}</th><td>{{ r.gwp_ar4 }}</td></tr>
            <tr><th>{{ T.gwpAr5 }}</th><td>{{ r.gwp_ar5 or "—" }}</td></tr>
            <tr><th>{{ T.boiling }}</th><td>{{ r.boiling_point or "—" }}</td></tr>
            {%- if r.replaces and r.replaces.length %}<tr><th>{{ T.replaces }}</th><td>{{ r.replaces | join(", ") }}</td></tr>{% endif %}
            {%- endif %}
            {%- for sp in p.specs %}<tr><th>{{ sp.k }}</th><td>{{ sp.v }}</td></tr>{% endfor %}
            {%- for k in p.packages %}<tr><th>{{ T.packages }} · {{ k.name }}</th><td>{{ k.kg | kg }} {{ k.unit or "kg" }}{% if k.lb %} ({{ k.lb | kg }} lb){% endif %}{% if k.sku %} · SKU {{ k.sku }}{% endif %}{% if k.special %} · {{ T.specialOrder }}{% endif %}</td></tr>{% endfor %}
          </tbody></table>
          <p class="note">{{ T.dataNote }}</p>
        </div>
      </details>
      {%- endif %}

      <details id="pd-docs">
        <summary><h2>{{ T.docsTitle }}</h2><span class="chev">{{ icon("chev") }}</span></summary>
        <div class="pd-acc-body">
          <p class="muted" style="margin-bottom:14px">{{ T.docsLead }}</p>
          {%- if p.documents and p.documents.length %}
            {%- for d in p.documents %}
            <div class="doc-row">
              <div class="doc-ic">{{ d.type or "PDF" }}</div>
              <div class="doc-meta"><div class="dt">{{ d.label }}</div><div class="dd">{{ p.name }} · PDF</div></div>
              {%- if d.file %}<a class="doc-dl" href="{{ d.file }}" target="_blank" rel="noopener">{{ T.download }}</a>
              {%- else %}<a class="doc-dl" href="{{ contactUrl }}?product={{ (p.name ~ ' — ' ~ d.label) | urlencode }}">{{ T.requestDoc }}</a>{% endif %}
            </div>
            {%- endfor %}
          {%- else %}<p class="muted">{{ T.noDocs }}</p>{% endif %}
        </div>
      </details>

      {%- if apps.length %}
      <details id="pd-apps">
        <summary><h2>{{ T.applications }}</h2><span class="chev">{{ icon("chev") }}</span></summary>
        <div class="pd-acc-body">
          <div class="pd-apps">
            {%- for a in apps %}<div class="pd-app"><img src="{{ a.icon_image or ('/assets/img/icons/' ~ (a.icon or 'snow') ~ '.svg') }}" alt="" width="44" height="44" loading="lazy"><span>{{ a.label }}</span></div>{% endfor %}
          </div>
        </div>
      </details>
      {%- endif %}

      {%- if p.faq and p.faq.length %}
      <details id="pd-faq">
        <summary><h2>{{ T.tabFaq }}</h2><span class="chev">{{ icon("chev") }}</span></summary>
        <div class="pd-acc-body faq">
          {%- for f in p.faq %}<details{% if loop.first %} open{% endif %}><summary>{{ f.q }}<span class="chev">{{ icon("chev") }}</span></summary><div class="ans">{{ f.a }}</div></details>{% endfor %}
        </div>
      </details>
      {%- endif %}
    </div>

    {%- if rel.length %}
    <section class="pd-related" id="pd-related">
      <h2>{{ T.relatedProducts }}</h2>
      <div class="prod-grid">{% for o in rel %}{{ productCard(o, lang, T) }}{% endfor %}</div>
    </section>
    {%- endif %}
  </div>
</div>

{#- ===== bottom: three help tiles ===== -#}
<section class="container pd-help">
  <a class="pd-help-tile" href="{{ '/technical/' | u(lang) }}"><span class="ph-ic">{{ icon("flask") }}</span><b>{{ T.technical }}</b><span>{{ T.techLead }}</span><em>→</em></a>
  <a class="pd-help-tile" href="{{ '/retrofit/' | u(lang) }}"><span class="ph-ic">{{ icon("wrench") }}</span><b>{{ T.findReplacement }}</b><span>{{ T.techRetroDesc }}</span><em>→</em></a>
  <a class="pd-help-tile is-accent" href="{{ contactUrl }}"><span class="ph-ic">{{ icon("headset") }}</span><b>{{ T.contact }}</b><span>{{ T.needHelpText }}</span><em>→</em></a>
</section>

<div class="sticky-cta">
  {%- if S.line_id %}<a class="btn btn-line js-line" href="https://line.me/R/ti/p/{{ S.line_id | urlencode }}" target="_blank" rel="noopener">LINE</a>{% else %}<a class="btn btn-ghost" href="tel:{{ S.phone }}">{{ T.call }}</a>{% endif %}
  <a class="btn btn-primary js-quote" href="{{ contactUrl }}?product={{ p.name | urlencode }}">{{ T.requestQuote }}</a>
</div>

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": p.name,
  "description": p.short,
  "brand": { "@type": "Brand", "name": b.name if b else S.brand_name },
  "sku": p.packages[0].sku if (p.packages and p.packages[0]) else "",
  "category": "Refrigerant",
  "image": ((p.coverImage or "/assets/img/orafon-logo.png") | absUrl(S.site_url))
} | json | safe }}</script>
