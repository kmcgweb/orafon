---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/technical/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /technical/
section: technical
eleventyComputed:
  title: "{{ i18n[lang].technical }}"
  description: "{{ i18n[lang].techLead }}"
---
{%- from "partials/macros.njk" import icon -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set techTab = "overview" -%}
{%- set techTitle = T.technical -%}
{%- set techLead = T.techLead -%}
{% include "partials/tech-head.njk" %}

<section class="section" style="padding-top:28px"><div class="container">
  <div class="tech-cards">
    <a class="tech-card" href="{{ '/retrofit/' | u(lang) }}">
      <span class="tc-ic">{{ icon("cube") }}</span>
      <span class="tc-num">{{ D.retrofitPairs }} <small>{{ T.pairs }}</small></span>
      <h3>{{ T.retrofit }}</h3>
      <p>{{ T.techRetroDesc }}</p>
      <span class="tc-go">{{ T.open }} →</span>
    </a>
    <a class="tech-card" href="{{ '/documents/' | u(lang) }}">
      <span class="tc-ic">{{ icon("doc") }}</span>
      <span class="tc-num">{{ D.documents.length }} <small>{{ T.docsCount }}</small></span>
      <h3>{{ T.documents }}</h3>
      <p>{{ T.techDocsDesc }}</p>
      <span class="tc-go">{{ T.open }} →</span>
    </a>
    <a class="tech-card" href="{{ '/articles/' | u(lang) }}">
      <span class="tc-ic">{{ icon("list") }}</span>
      <span class="tc-num">{{ D.articles.length }} <small>{{ T.articlesCount }}</small></span>
      <h3>{{ T.articles }}</h3>
      <p>{{ T.articlesLead }}</p>
      <span class="tc-go">{{ T.open }} →</span>
    </a>
    <a class="tech-card" href="{{ '/contact/' | u(lang) }}">
      <span class="tc-ic">{{ icon("chat") }}</span>
      <span class="tc-num">{{ D.products.length }} <small>{{ T.items }}</small></span>
      <h3>{{ T.needHelp }}</h3>
      <p>{{ T.needHelpText }}</p>
      <span class="tc-go">{{ T.contactSales }} →</span>
    </a>
  </div>
</div></section>

{%- if D.articles.length %}
<section class="section" style="padding-top:0"><div class="container">
  <div class="sec-head">
    <h2 class="display">{{ T.latestArticles }}</h2>
    <a class="btn btn-ghost" href="{{ '/articles/' | u(lang) }}">{{ T.allArticles }} →</a>
  </div>
  <div class="art-grid">
    {%- for a in D.articles | batch(3) | first %}
    <a class="art-card" href="{{ ('/articles/' ~ a.slug ~ '/') | u(lang) }}">
      <div class="cover">{% if a.cover %}<img src="{{ a.cover }}" alt="" loading="lazy">{% else %}<span class="cover-ph">{{ icon("list") }}</span>{% endif %}</div>
      <div class="b"><time datetime="{{ a.date | isoDate }}">{{ a.date | dateFmt(lang) }}</time><h3>{{ a.title }}</h3><p>{{ a.excerpt }}</p><span class="art-more">{{ T.readMore }} →</span></div>
    </a>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

<section class="section" style="padding-top:0"><div class="container">
  <h2 class="display">{{ T.finder }}</h2>
  <p class="lead">{{ T.finderLead }}</p>
  <div class="class-groups">
    {%- for g in D.refsByClass %}
    {%- set sold = [] %}{% for r in g.items %}{% if r.products.length %}{% set sold = sold.concat([r]) %}{% endif %}{% endfor %}
    {%- if sold.length %}
    <div class="class-group">
      <div class="cg-head"><span class="chip i">{{ g.class }}</span><span class="muted">{{ sold.length }} {{ T.grades }}</span></div>
      <p class="cg-desc">{{ T.classDesc[g.class] }}</p>
      <div class="cg-grades">
        {%- for r in sold %}
        <a class="grade-chip" href="{{ r.url | u(lang) }}" style="--c:{{ r.color or '#4F46E5' }}">
          <b>{{ r.number }}</b><span>{{ r.safety }} · GWP {{ r.gwp_ar4 }}</span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</div></section>

<section class="section" style="padding-top:0"><div class="container">
  <h2 class="display">{{ T.safetyGuide }}</h2>
  <p class="lead">{{ T.safetyGuideLead }}</p>
  <div class="safety-grid">
    {%- for s in ["A1", "A2L", "A2", "A3", "B1"] %}
    <div class="safety-card sf-{{ s }}">
      <div class="sf-code">{{ s }}</div>
      <div class="sf-name">{{ T.safetyText[s] | replace(s ~ " — ", "") }}</div>
      <p>{{ T.safetyDesc[s] }}</p>
      {%- if D.safetyCounts[s] %}<span class="sf-count">{{ D.safetyCounts[s] }} {{ T.grades }}</span>{% endif %}
    </div>
    {%- endfor %}
  </div>
</div></section>

