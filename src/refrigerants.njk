---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/refrigerants/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /refrigerants/
section: technical
pageScript: filter.js
eleventyComputed:
  title: "{{ i18n[lang].refrigerants }} — {{ i18n[lang].technical }}"
  description: "{{ i18n[lang].refsLead }}"
---
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set techTab = "refrigerants" -%}
{%- set techTitle = T.refrigerants -%}
{%- set techLead = T.refsLead -%}
{% include "partials/tech-head.njk" %}

<section class="section" style="padding-top:28px" data-filter><div class="container">
  <div class="filter-bar" style="margin-top:0">
    <div class="filter-row"><input class="q-input" type="search" data-f-search placeholder="{{ T.searchGrade }}" aria-label="{{ T.search }}"></div>
    <div class="filter-row" data-f-group="class">
      <span class="lbl">{{ T.type }}</span>
      <button class="filter active" data-v="">{{ T.all }}</button>
      {%- for g in D.refsByClass %}<button class="filter" data-v="{{ g.class }}">{{ g.class }}</button>{% endfor %}
    </div>
    <div class="filter-row" data-f-group="safety">
      <span class="lbl">ASHRAE</span>
      <button class="filter active" data-v="">{{ T.all }}</button>
      {%- for s, n in D.safetyCounts %}{% if n %}<button class="filter" data-v="{{ s }}">{{ s }}</button>{% endif %}{% endfor %}
    </div>
  </div>
  <div class="count" data-f-count data-tpl="{{ T.showing }} {n} {{ T.grades }}">{{ T.showing }} {{ D.refrigerants.length }} {{ T.grades }}</div>

  <div class="table-wrap">
    <table class="data-table ref-table">
      <thead><tr>
        <th>{{ T.ashrae }}</th><th>{{ T.refType }}</th><th>ASHRAE</th><th>{{ T.gwp }}</th><th>{{ T.odp }}</th><th>{{ T.replaces }}</th><th>{{ T.products }}</th>
      </tr></thead>
      <tbody>
        {%- for r in D.refrigerants %}
        <tr data-f-item data-class="{{ r.class }}" data-safety="{{ r.safety }}" data-text="{{ (r.number ~ ' ' ~ r.class ~ ' ' ~ (r.replaces | join(' ')) ~ ' ' ~ r.composition) | lower }}">
          <td><a class="ref-num" href="{{ ('/refrigerants/' ~ r.slug ~ '/') | u(lang) }}"><span class="dot" style="background:{{ r.color }}"></span>{{ r.number }}</a></td>
          <td>{{ r.class }}</td>
          <td><span class="chip sfc sf-{{ r.safety }}">{{ r.safety }}</span></td>
          <td><span class="gwp-bar" style="--w:{{ r.gwp_ar4 | gwpBar }}%"></span>{{ r.gwp_ar4 }}</td>
          <td>{{ r.odp }}</td>
          <td class="muted">{{ r.replaces | join(", ") or "—" }}</td>
          <td>{% if r.products.length %}<a href="{{ ('/refrigerants/' ~ r.slug ~ '/') | u(lang) }}#products">{{ r.products.length }}</a>{% else %}—{% endif %}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
  <div class="card empty" data-f-empty hidden>{{ T.noResults }}</div>
  <p class="note">{{ T.dataNote }}</p>
</div></section>
