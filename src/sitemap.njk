---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Pages in both languages, with hreflang alternates. Product pages also list their images
    (Google Images: image sitemap extension) so our own pages are the source Google ties the photos to. -#}
{%- set site = db.th.site.site_url -%}
{%- set paths = ["/", "/products/", "/technical/", "/retrofit/", "/documents/", "/about/", "/contact/", "/privacy/", "/terms/"] -%}
{%- if db.th.articles.length %}{% set paths = paths.concat(["/articles/"]) %}{% endif -%}
{%- for b in db.th.brands %}{% set paths = paths.concat(["/brands/" ~ b.slug ~ "/"]) %}{% endfor -%}
{%- for a in db.th.articles %}{% set paths = paths.concat(["/articles/" ~ a.slug ~ "/"]) %}{% endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for p in paths %}
{%- for l in langs %}
  <url>
    <loc>{{ (p | u(l)) | absUrl(site) }}</loc>
    {%- for l2 in langs %}
    <xhtml:link rel="alternate" hreflang="{{ l2 }}" href="{{ (p | u(l2)) | absUrl(site) }}"/>
    {%- endfor %}
  </url>
{%- endfor %}
{%- endfor %}
{%- for prod in db.th.products %}
{%- set p = "/products/" ~ prod.slug ~ "/" %}
{%- for l in langs %}
  <url>
    <loc>{{ (p | u(l)) | absUrl(site) }}</loc>
    {%- for l2 in langs %}
    <xhtml:link rel="alternate" hreflang="{{ l2 }}" href="{{ (p | u(l2)) | absUrl(site) }}"/>
    {%- endfor %}
    {%- for img in prod.gallery %}
    <image:image><image:loc>{{ img | absUrl(site) }}</image:loc></image:image>
    {%- endfor %}
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
