---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /
section: home
pageScript: home.js
---
{#- Home: banner slider → promo tiles → featured products → wide banner → brands → stats → CTA.
    Every image slot is edited in /admin (หน้าเว็บ → หน้าแรก). Empty slots render a designed placeholder with the recommended size. -#}
{%- from "partials/macros.njk" import cylinder, productCard, icon -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set H = D.home -%}
{%- set featured = D.featured -%}

{%- set imgIcon = icon("image") -%}

{#- Hero slider. A slide with an uploaded image shows the image; a slide linked to a product (no image)
    is built from that product's data: tank colour, cover photo, grade, specs, replaces. -#}
{%- macro specRow(r, T) -%}
{%- if r %}
<dl class="hx-specs">
  <div><dt>GWP</dt><dd>{{ r.gwp_ar4 or "—" }}</dd></div>
  <div><dt>ODP</dt><dd>{{ r.odp or "—" }}</dd></div>
  <div><dt>ASHRAE</dt><dd>{{ r.safety or "—" }}</dd></div>
  {%- if r.replaces and r.replaces.length %}<div><dt>{{ T.replaces }}</dt><dd>{{ r.replaces | join(", ") }}</dd></div>{% endif %}
</dl>
{%- endif %}
{%- endmacro -%}

{%- if H.slides and H.slides.length %}
<h1 class="sr-only">{{ H.hero_title }} {{ H.hero_highlight }} — {{ D.site.brand_name }}</h1>
<section class="hero-slider-wrap"><div class="container">
  <div class="hero-slider" id="heroSlider" aria-roledescription="carousel" aria-label="{{ D.site.brand_name }}">
    {%- for s in H.slides %}
    {%- set p = D.productMap[s.product] if s.product else null %}
    {%- set r = p.ref if p else null %}
    {%- set href = s | bannerHref(lang) %}
    <div class="hs-slide{% if loop.first %} active{% endif %}{% if not s.image %}{% if p %} is-prod{% else %} is-ph{% endif %}{% endif %}"{% if p %} style="--c:{{ p.tankColor }}"{% endif %} role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ H.slides.length }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
      {%- if s.image %}
      <picture>
        {%- if s.image_mobile %}<source media="(max-width:768px)" srcset="{{ s.image_mobile }}">{% endif %}
        <img src="{{ s.image }}" alt="{{ s.title }}"{% if not loop.first %} loading="lazy"{% endif %}>
      </picture>
      {%- if s.title or s.text %}
      <div class="hs-content">
        {%- if s.title %}<h2>{{ s.title }}</h2>{% endif %}
        {%- if s.text %}<p>{{ s.text }}</p>{% endif %}
        {%- if s.button %}<a class="btn btn-white" href="{{ href }}">{{ s.button }} →</a>{% endif %}
      </div>
      {%- else %}<a class="hs-link" href="{{ href }}" aria-label="{{ s.title or D.site.brand_name }}"></a>{% endif %}

      {%- elif p %}
      <div class="hx-bg" aria-hidden="true">{% if p.brandObj and p.brandObj.logo %}<span class="hx-logo" style="background-image:url('{{ p.brandObj.logo }}')"></span>{% endif %}</div>
      <div class="hx-grid">
        <div class="hx-text">
          <span class="hx-kicker">{{ p.brandObj.name if p.brandObj }}{% if r %} · {{ r.class }}{% endif %}</span>
          <h2>{{ s.title or p.name }}</h2>
          <p>{{ s.text or p.tagline }}</p>
          {{ specRow(r, T) }}
          <div class="hx-cta">
            <a class="btn hx-btn" href="{{ href }}">{{ s.button or T.viewDetails }} →</a>
            <a class="btn hx-btn-o" href="{{ ('/contact/' | u(lang)) ~ '?product=' ~ (p.name | urlencode) }}">{{ T.requestQuote }}</a>
          </div>
        </div>
        <a class="hx-art" href="{{ href }}" tabindex="-1" aria-hidden="true">
          <span class="hx-disc"></span>
          {%- if p.coverImage %}<img src="{{ p.coverImage }}" alt=""{% if not loop.first %} loading="lazy"{% endif %}>{% else %}{{ cylinder(r, "slide-" ~ loop.index) }}{% endif %}
        </a>
      </div>

      {%- else %}
      <div class="hs-ph">
        <div class="hs-ph-art is-icon">{{ icon("doc") }}</div>
        <span class="ph-hint">{{ imgIcon | safe }} {{ T.imgSlot }} <i class="d">1920×720 px</i><i class="m">1080×1350 px</i></span>
      </div>
      <div class="hs-content">
        {%- if s.title %}<h2>{{ s.title }}</h2>{% endif %}
        {%- if s.text %}<p>{{ s.text }}</p>{% endif %}
        {%- if s.button %}<a class="btn btn-white" href="{{ href }}">{{ s.button }} →</a>{% endif %}
      </div>
      {%- endif %}
    </div>
    {%- endfor %}
    {%- if H.slides.length > 1 %}
    <div class="hs-bar">
      <div class="hs-dots" role="tablist">
        {%- for s in H.slides %}<button type="button" class="{{ 'active' if loop.first }}" aria-label="{{ loop.index }}"><span></span></button>{% endfor %}
      </div>
      <button class="hs-nav prev" type="button" aria-label="Previous">{{ icon("chev") }}</button>
      <button class="hs-nav next" type="button" aria-label="Next">{{ icon("chev") }}</button>
    </div>
    {%- endif %}
  </div>
</div></section>
{%- else %}
{#- no slides configured: fall back to the text hero -#}
<section class="hero"><div class="container">
  <h1 class="display">{{ H.hero_title }} <span class="grad-text">{{ H.hero_highlight }}</span></h1>
  <p class="lead">{{ H.hero_lead }}</p>
  <div class="hero-cta">
    <a class="btn btn-primary grad-bg" href="{{ '/products/' | u(lang) }}">{{ T.viewAll }}</a>
    <a class="btn btn-ghost" href="{{ '/contact/' | u(lang) }}">{{ T.requestQuote }}</a>
  </div>
</div></section>
{%- endif %}

{%- if H.promos and H.promos.length %}
<section class="promo-wrap"><div class="container">
  <div class="promo-grid">
    {%- for m in H.promos %}
    {%- set p = D.productMap[m.product] if m.product else null %}
    {%- set r = p.ref if p else null %}
    {%- if m.image or not p %}
    <a class="promo-tile{% if not m.image %} is-ph{% endif %}" href="{{ m | bannerHref(lang) }}">
      {%- if m.image %}<img src="{{ m.image }}" alt="{{ m.title }}" loading="lazy">
      {%- else %}
      <span class="pt-ph">{{ cylinder(null, "promo-" ~ loop.index) }}</span>
      <span class="ph-hint">{{ imgIcon | safe }} {{ T.imgSlot }} 800×600 px</span>
      {%- endif %}
      <span class="pt-text"><b>{{ m.title }}</b>{% if m.text %}<span>{{ m.text }}</span>{% endif %}</span>
    </a>
    {%- else %}
    <a class="promo-tile is-prod" href="{{ m | bannerHref(lang) }}" style="--c:{{ p.tankColor }}">
      <span class="pp-art">
        {%- if p.brandObj and p.brandObj.logo %}<span class="pp-logo" style="background-image:url('{{ p.brandObj.logo }}')" role="img" aria-label="{{ p.brandObj.name }}"></span>{% endif %}
        {%- if p.coverImage %}<img src="{{ p.coverImage }}" alt="" loading="lazy">{% else %}{{ cylinder(r, "promo-" ~ loop.index) }}{% endif %}
      </span>
      <span class="pp-body">
        <span class="pp-kicker">{{ p.brandObj.name if p.brandObj }}{% if r %} · {{ r.class }}{% endif %}</span>
        <b>{{ m.title or p.name }}</b>
        <span class="pp-text">{{ m.text or p.tagline }}</span>
        {%- if r %}<span class="pp-chips"><i>GWP {{ r.gwp_ar4 }}</i><i class="sf-{{ r.safety }}">{{ r.safety }}</i>{% if r.replaces and r.replaces.length %}<i>{{ T.replaces }} {{ r.replaces[0] }}</i>{% endif %}</span>{% endif %}
        <em>{{ T.viewDetails }} <span aria-hidden="true">→</span></em>
      </span>
    </a>
    {%- endif %}
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

{%- set showList = featured if featured.length else D.products %}
{%- if showList.length %}
<section class="section"><div class="container">
  <h2 class="display">{{ T.featured }}</h2>
  <p class="lead">{{ T.featuredLead }}</p>
  <div class="prod-grid">
    {%- for p in showList | batch(8) | first %}{{ productCard(p, lang, T) }}{% endfor %}
  </div>
  <div style="margin-top:28px"><a class="btn btn-ghost" href="{{ '/products/' | u(lang) }}">{{ T.viewAll }} →</a></div>
</div></section>
{%- endif %}

{%- if D.classCounts.length %}
<section class="section" style="padding-top:0"><div class="container">
  <span class="kicker">{{ T.byClass }}</span>
  <h2 class="display">{{ T.browseByClass }}</h2>
  <p class="lead" style="margin-bottom:0">{{ T.browseByClassLead }}</p>
  <div class="class-tiles">
    {%- for g in D.classCounts %}
    <a class="class-tile" href="{{ ('/products/?class=' ~ (g.class | urlencode)) | u(lang) }}">
      <span class="ct-top"><b>{{ g.class }}</b><span>{{ g.n }} {{ T.productsN }}</span></span>
      <p>{{ T.classDesc[g.class] }}</p>
      <em>{{ T.viewAll }} →</em>
    </a>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

{%- set w = H.wide_banner %}
{%- if w and (w.image or w.title) %}
<section class="section" style="padding-top:0"><div class="container">
  <a class="wide-banner{% if not w.image %} is-ph{% endif %}" href="{{ w | bannerHref(lang) }}">
    {%- if w.image %}
    <picture>
      {%- if w.image_mobile %}<source media="(max-width:768px)" srcset="{{ w.image_mobile }}">{% endif %}
      <img src="{{ w.image }}" alt="{{ w.title }}" loading="lazy">
    </picture>
    {%- else %}<span class="ph-hint">{{ imgIcon | safe }} {{ T.imgSlot }} <i class="d">1920×480 px</i><i class="m">1200×675 px</i></span>{% endif %}
    {%- if w.title %}
    <span class="wb-content">
      <b>{{ w.title }}</b>
      {%- if w.text %}<span>{{ w.text }}</span>{% endif %}
      {%- if w.button %}<em>{{ w.button }} →</em>{% endif %}
    </span>
    {%- endif %}
  </a>
</div></section>
{%- endif %}

<section class="section" style="padding-top:0"><div class="container">
  <h2 class="display">{{ T.ourBrands }}</h2>
  <div class="brand-cards" style="margin-top:24px">
    {%- for b in D.brands %}
    <a class="brand-card" href="{{ ('/brands/' ~ b.slug ~ '/') | u(lang) }}">
      <span class="bl">{% if b.logo %}<img src="{{ b.logo }}" alt="">{% else %}{{ b.name | first }}{% endif %}</span>
      <span><span class="chip {{ 'i' if b.own_brand else 'v' }}">{{ T.ownBrand if b.own_brand else T.distributor }}</span>
      <h3>{{ b.name }}</h3><p>{{ b.tagline }}</p></span>
    </a>
    {%- endfor %}
  </div>
</div></section>

{% include "partials/stats.njk" %}

