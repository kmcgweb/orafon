---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /
section: home
pageScript: home.js
---
{#- Home: banner slider → promo tiles → featured products → wide banner → brands → stats → CTA.
    Every image slot is edited in /admin (หน้าเว็บ → หน้าแรก). Empty slots render a designed placeholder with the recommended size. -#}
{%- from "partials/macros.njk" import cylinder, productCard, icon -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set H = D.home -%}
{%- set featured = D.featured -%}

{%- set imgIcon = icon("image") -%}

{#- Hero: corporate split slider — a full-bleed picture on the left and a diagonal brand panel on the right
    carrying the headline. Slides come from /admin (หน้าเว็บ → หน้าแรก → แบนเนอร์สไลด์). A slide with an uploaded
    banner image shows that photo; a slide linked to a product shows the product in a cool studio scene instead. -#}
{%- if H.slides and H.slides.length %}
<h1 class="sr-only">{{ H.hero_title }} {{ H.hero_highlight }} — {{ D.site.brand_name }}</h1>
<section class="dk-hero" id="heroSlider" aria-roledescription="carousel" aria-label="{{ D.site.brand_name }}">
  <div class="dk-media" aria-hidden="true">
    {%- for s in H.slides %}
    {%- set p = D.productMap[s.product] if s.product else null %}
    <div class="dk-slide{% if loop.first %} active{% endif %}{% if s.image %} is-photo{% endif %}" data-i="{{ loop.index0 }}" style="--c:{{ p.tankColor if p else '#2F3192' }}">
      {%- if s.image %}
      <picture>
        {%- if s.image_mobile %}<source media="(max-width:768px)" srcset="{{ s.image_mobile }}">{% endif %}
        <img src="{{ s.image }}" alt=""{% if not loop.first %} loading="lazy"{% endif %}>
      </picture>
      {%- else %}
      <span class="dk-studio"></span>
      {%- if p and p.ref %}<span class="dk-num">{{ p.ref.number | shortNum }}</span>{% elif p and p.oilGrade %}<span class="dk-num">{{ p.oilGrade }}</span>{% elif p %}<span class="dk-num">{{ p.name | replace("ORAFON ", "") | replace("Solstice® ", "") }}</span>{% endif %}
      {%- if p and p.coverImage %}<img class="dk-prod" src="{{ p.coverImage }}" alt=""{% if not loop.first %} loading="lazy"{% endif %}>
      {%- elif p %}<span class="dk-prod">{{ cylinder(p.ref, "dk-" ~ loop.index) }}</span>
      {%- else %}<img class="dk-prod dk-mark" src="/assets/img/penguin-white.png" alt="">{% endif %}
      <span class="dk-floor"></span>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>

  <div class="dk-panel">
    <div class="dk-texts">
      {%- for s in H.slides %}
      {%- set p = D.productMap[s.product] if s.product else null %}
      {%- set r = p.ref if p else null %}
      {%- set href = s | bannerHref(lang) %}
      {%- set pal = [["#0B6E6A","#14A39A"],["#1B2A8C","#2F6FD6"],["#4B1FA8","#7B4BE0"],["#7A1F5C","#C2418E"]] %}{%- set pc = pal[loop.index0 % 4] %}
      <div class="dk-text{% if loop.first %} active{% endif %}" data-i="{{ loop.index0 }}" data-p1="{{ s.color or pc[0] }}" data-p2="{{ s.color or pc[1] }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ H.slides.length }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
        <span class="dk-kicker">{% if p %}{{ p.brandObj.name if p.brandObj }}{% if r %} · {{ r.class }}{% elif p.kind %} · {{ p.kind }}{% endif %}{% else %}ORAFON REFRIGERANT{% endif %}</span>
        {#- non-breaking hyphens keep grade numbers such as R-448A on one line -#}
        <h2>{{ (s.title or (p.name if p)) | replace("-", "‑") }}</h2>
        <i class="dk-rule"></i>
        {%- if s.text or (p and p.tagline) %}<p>{{ s.text or p.tagline }}</p>{% endif %}
        {%- if r %}
        <dl class="dk-specs">
          <div><dt>GWP</dt><dd data-count="{{ r.gwp_ar4 }}">{{ r.gwp_ar4 or "—" }}</dd></div>
          <div><dt>ASHRAE</dt><dd>{{ r.safety or "—" }}</dd></div>
          <div><dt>ODP</dt><dd>{{ r.odp or "—" }}</dd></div>
        </dl>
        {%- endif %}
        <div class="dk-cta">
          <a class="dk-btn" href="{{ href }}">{{ s.button or T.viewDetails }} <span aria-hidden="true">→</span></a>
          <a class="dk-btn ghost" href="{{ '/contact/' | u(lang) }}{% if p %}?product={{ p.name | urlencode }}{% endif %}">{{ T.requestQuote }}</a>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>

  {%- if H.slides.length > 1 %}
  <div class="dk-bar">
    <div class="dk-dots" role="tablist">
      {%- for s in H.slides %}
      {%- set p = D.productMap[s.product] if s.product else null %}
      <button type="button" role="tab" class="{{ 'active' if loop.first }}" aria-selected="{{ 'true' if loop.first else 'false' }}" aria-label="{{ (p.name if p) or s.title }}"><b>{{ "0" if loop.index < 10 }}{{ loop.index }}</b><i><em></em></i></button>
      {%- endfor %}
    </div>
    <div class="dk-arrows">
      <button class="dk-arrow prev" type="button" aria-label="Previous">{{ icon("chev") }}</button>
      <button class="dk-arrow next" type="button" aria-label="Next">{{ icon("chev") }}</button>
    </div>
  </div>
  {%- endif %}
</section>
{%- else %}
{#- no slides configured: fall back to the text hero -#}
<section class="hero"><div class="container">
  <h1 class="display">{{ H.hero_title }} <span class="grad-text">{{ H.hero_highlight }}</span></h1>
  <p class="lead">{{ H.hero_lead }}</p>
  <div class="hero-cta">
    <a class="btn btn-primary grad-bg" href="{{ '/products/' | u(lang) }}">{{ T.viewAll }}</a>
    <a class="btn btn-ghost" href="{{ '/contact/' | u(lang) }}">{{ T.requestQuote }}</a>
  </div>
</div></section>
{%- endif %}

{#- Promo tiles under the hero: a product tile is built from the product (photo, specs); an uploaded image tile shows the image -#}
{%- if H.promos and H.promos.length %}
<section class="lx-promos"><div class="container">
  <div class="lxp-grid">
    {%- for m in H.promos %}
    {%- set p = D.productMap[m.product] if m.product else null %}
    {%- set r = p.ref if p else null %}
    <a class="lxp{% if m.image %} is-img{% endif %}" href="{{ m | bannerHref(lang) }}" style="--c:{{ p.tankColor if p else '#2F3192' }}">
      {%- if m.image %}<img class="lxp-cover" src="{{ m.image }}" alt="{{ m.title }}" loading="lazy">
      {%- else %}
      <span class="lxp-art">
        {%- if p and p.coverImage %}<img src="{{ p.coverImage }}" alt="{{ p.imageAlt }}" loading="lazy">{% else %}{{ cylinder(r, "promo-" ~ loop.index) }}{% endif %}
      </span>
      {%- endif %}
      <span class="lxp-body">
        {%- if p %}<span class="lxp-kicker">{{ p.brandObj.name if p.brandObj }}{% if r %} · {{ r.class }}{% endif %}</span>{% endif %}
        <b>{{ m.title or (p.name if p) }}</b>
        {%- if m.text or (p and p.tagline) %}<span class="lxp-text">{{ m.text or p.tagline }}</span>{% endif %}
        {%- if r %}<span class="lxp-stats"><span><i>GWP</i>{{ r.gwp_ar4 }}</span><span><i>ASHRAE</i>{{ r.safety }}</span>{% if r.replaces and r.replaces.length %}<span><i>{{ T.replaces }}</i>{{ r.replaces[0] }}</span>{% endif %}</span>{% endif %}
        <em>{{ T.viewDetails }} <span aria-hidden="true">→</span></em>
      </span>
    </a>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

{%- if D.classCounts.length %}
<section class="section hsec"><div class="container">
  <span class="kicker">{{ T.byClass }}</span>
  <h2 class="display">{{ T.browseByClass }}</h2>
  <p class="lead" style="margin-bottom:0">{{ T.browseByClassLead }}</p>
  <div class="class-tiles">
    {%- for g in D.classCounts %}
    <a class="class-tile" href="{{ ('/products/?class=' ~ (g.class | urlencode)) | u(lang) }}">
      <span class="ct-top"><b>{{ g.class }}</b><span>{{ g.n }} {{ T.productsN }}</span></span>
      <p>{{ T.classDesc[g.class] }}</p>
      <em>{{ T.viewAll }} →</em>
    </a>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

{%- set w = H.wide_banner %}
{%- if w and (w.image or w.title) %}
<section class="section hsec"><div class="container">
  <a class="wide-banner{% if not w.image %} is-ph{% endif %}" href="{{ w | bannerHref(lang) }}">
    {%- if w.image %}
    <picture>
      {%- if w.image_mobile %}<source media="(max-width:768px)" srcset="{{ w.image_mobile }}">{% endif %}
      <img src="{{ w.image }}" alt="{{ w.title }}" loading="lazy">
    </picture>
    {%- else %}<span class="ph-hint">{{ imgIcon | safe }} {{ T.imgSlot }} <i class="d">1920×480 px</i><i class="m">1200×675 px</i></span>{% endif %}
    {%- if w.logo %}<img class="wb-logo" src="{{ w.logo }}" alt="" loading="lazy">{% endif %}
    {%- if w.title %}
    <span class="wb-content">
      <b>{{ w.title }}</b>
      {%- if w.text %}<span>{{ w.text }}</span>{% endif %}
      {%- if w.button %}<em>{{ w.button }} →</em>{% endif %}
    </span>
    {%- endif %}
  </a>
</div></section>
{%- endif %}

{%- if H.clients and H.clients.length %}
<section class="section hsec" id="clients"><div class="container">
  <h2 class="display">{{ H.clients_title }}</h2>
  {%- if H.clients_lead %}<p class="lead">{{ H.clients_lead }}</p>{% endif %}
</div>
  {#- two rows drifting in opposite directions; each row repeats its logos 4x and slides half the track, so the loop is seamless on wide screens -#}
  {%- set half = (H.clients.length / 2) | round(0, "ceil") %}
  <div class="client-marquee">
    {%- for row in [H.clients.slice(0, half), H.clients.slice(half)] %}
    <div class="cm-row{% if loop.index == 2 %} rev{% endif %}">
      <ul class="cm-track">
        {%- for rep in [1, 2, 3, 4] %}{% for c in row %}<li class="client-logo cl-{{ c.name | slugify }}"{% if rep > 1 %} aria-hidden="true"{% endif %}>{% if c.logo %}<img src="{{ c.logo }}" alt="{{ c.name if rep == 1 }}" loading="lazy">{% else %}<span class="client-name">{{ c.name }}</span>{% endif %}</li>{% endfor %}{% endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
</section>
{%- endif %}
