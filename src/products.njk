---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/products/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /products/
section: products
pageScript: products.js
eleventyComputed:
  title: "{{ i18n[lang].allProducts }}"
  description: "{{ i18n[lang].productsLead }}"
---
{%- from "partials/macros.njk" import productCard, icon -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb"><a href="{{ '/' | u(lang) }}">{{ D.site.brand_name }}</a><span>›</span>{{ T.allProducts }}</nav></div>
<section class="page-head"><div class="container">
  <h1 class="display">{{ T.allProducts }}</h1>
  <p>{{ T.productsLead }}</p>

  <div class="toolbar" id="filters">
    <div class="tb-search">
      {{ icon("search") }}
      <label class="sr-only" for="q">{{ T.search }}</label>
      <input id="q" type="search" placeholder="{{ T.searchPh }}">
    </div>
    {%- if D.usedLabels.length %}
    <select class="tb-select" data-key="label" aria-label="{{ T.labelFilter }}">
      <option value="">{{ T.allLabels }}</option>
      {%- for l in D.usedLabels %}<option value="{{ l }}">{{ T.labels[l] }}</option>{% endfor %}
    </select>
    {%- endif %}
    <select class="tb-select" data-key="class" aria-label="{{ T.type }}">
      <option value="">{{ T.allTypes }}</option>
      {%- for c in D.classes %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
    </select>
    <select class="tb-select" data-key="brand" aria-label="{{ T.brand }}">
      <option value="">{{ T.allBrands }}</option>
      {%- for b in D.brands %}{% if b.products.length %}<option value="{{ b.slug }}">{{ b.name }}</option>{% endif %}{% endfor %}
    </select>
    <select class="tb-select" data-key="ref" aria-label="{{ T.refrigerant }}">
      <option value="">{{ T.allGrades }}</option>
      {%- for r in D.refrigerants %}{% if r.products.length %}<option value="{{ r.slug }}">{{ r.number }}</option>{% endif %}{% endfor %}
    </select>
    <button type="button" class="tb-reset" id="reset" hidden>✕ {{ T.clearFilters }}</button>
  </div>
</div></section>

<section style="padding-bottom:64px"><div class="container">
  <div class="count" id="count" data-tpl="{{ T.showing }} {n} {{ T.items }}">{{ T.showing }} {{ D.products.length }} {{ T.items }}</div>
  <div class="prod-grid" id="grid">
    {%- for p in D.products %}{{ productCard(p, lang, T) }}{% endfor %}
  </div>
  <div class="card empty" id="empty" {% if D.products.length %}hidden{% endif %}>
    {{ T.noResults if D.products.length else T.comingSoon }}
    <div style="margin-top:16px"><a class="btn btn-ghost" href="{{ '/contact/' | u(lang) }}">{{ T.contactSales }}</a></div>
  </div>
</div></section>
