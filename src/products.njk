---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/products/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /products/
section: products
pageScript: products.js
eleventyComputed:
  title: "{{ i18n[lang].allProducts }}"
  description: "{{ i18n[lang].productsLead }}"
---
{%- from "partials/macros.njk" import productCard -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb"><a href="{{ '/' | u(lang) }}">{{ D.site.brand_name }}</a><span>›</span>{{ T.allProducts }}</nav></div>
<section class="page-head"><div class="container">
  <h1 class="display">{{ T.allProducts }}</h1>
  <p>{{ T.productsLead }}</p>

  <div class="filter-bar" id="filters">
    <div class="filter-row">
      <label class="sr-only" for="q">{{ T.search }}</label>
      <input class="q-input" id="q" type="search" placeholder="{{ T.searchPh }}">
    </div>
    {%- if D.usedLabels.length %}
    <div class="filter-row" data-group="label">
      <span class="lbl">{{ T.labelFilter }}</span>
      <button class="filter active" data-v="">{{ T.all }}</button>
      {%- for l in D.usedLabels %}<button class="filter" data-v="{{ l }}">{{ T.labels[l] }}</button>{% endfor %}
    </div>
    {%- endif %}
    <div class="filter-row" data-group="class">
      <span class="lbl">{{ T.type }}</span>
      <button class="filter active" data-v="">{{ T.all }}</button>
      {%- for c in D.classes %}<button class="filter" data-v="{{ c }}">{{ c }}</button>{% endfor %}
    </div>
    <div class="filter-row" data-group="brand">
      <span class="lbl">{{ T.brand }}</span>
      <button class="filter active" data-v="">{{ T.all }}</button>
      {%- for b in D.brands %}{% if b.products.length %}<button class="filter" data-v="{{ b.slug }}">{{ b.name }}</button>{% endif %}{% endfor %}
    </div>
    <div class="filter-row">
      <label class="lbl" for="ref">{{ T.refrigerant }}</label>
      <select class="q-input" id="ref" style="min-width:200px">
        <option value="">{{ T.all }}</option>
        {%- for r in D.refrigerants %}{% if r.products.length %}<option value="{{ r.slug }}">{{ r.number }} · {{ r.class }}</option>{% endif %}{% endfor %}
      </select>
    </div>
  </div>
</div></section>

<section style="padding-bottom:64px"><div class="container">
  <div class="count" id="count" data-tpl="{{ T.showing }} {n} {{ T.items }}">{{ T.showing }} {{ D.products.length }} {{ T.items }}</div>
  <div class="prod-grid" id="grid">
    {%- for p in D.products %}{{ productCard(p, lang, T) }}{% endfor %}
  </div>
  <div class="card empty" id="empty" {% if D.products.length %}hidden{% endif %}>
    {{ T.noResults if D.products.length else T.comingSoon }}
    <div style="margin-top:16px"><a class="btn btn-ghost" href="{{ '/contact/' | u(lang) }}">{{ T.contactSales }}</a></div>
  </div>
</div></section>
