---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/products/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /products/
section: products
pageScript: products.js
eleventyComputed:
  title: "{{ i18n[lang].allProducts }}"
  description: "{{ i18n[lang].productsLead }}"
---
{%- from "partials/macros.njk" import productCard, icon, tagBadge -%}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb"><a href="{{ '/' | u(lang) }}">{{ T.home }}</a><span>›</span>{{ T.allProducts }}</nav></div>
<section class="page-head"><div class="container">
  <h1 class="display">{{ T.allProducts }}</h1>
  <p>{{ T.productsLead }}</p>

  <div class="toolbar" id="filters">
    <div class="tb-search">
      {{ icon("search") }}
      <label class="sr-only" for="q">{{ T.search }}</label>
      <input id="q" type="search" placeholder="{{ T.searchPh }}">
    </div>
    {%- if D.usedLabels.length %}
    <select class="tb-select" data-key="label" aria-label="{{ T.labelFilter }}">
      <option value="">{{ T.allLabels }}</option>
      {%- for l in D.usedLabels %}<option value="{{ l }}">{{ T.labels[l] }}</option>{% endfor %}
    </select>
    {%- endif %}
    {%- if D.catCounts.length > 1 %}
    <select class="tb-select" data-key="cat" aria-label="{{ T.category }}">
      <option value="">{{ T.allCats }}</option>
      {%- for c in D.catCounts %}<option value="{{ c.key }}">{{ T.cats[c.key] }}</option>{% endfor %}
    </select>
    {%- endif %}
    <select class="tb-select" data-key="class" aria-label="{{ T.type }}">
      <option value="">{{ T.allTypes }}</option>
      {%- if D.oilTypes.length %}<optgroup label="{{ T.cats.refrigerant }}">{% endif %}
      {%- for c in D.classes %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
      {%- if D.oilTypes.length %}</optgroup><optgroup label="{{ T.cats.oil }}">{% for o in D.oilTypes %}<option value="{{ o.type }}">{{ o.type }} ({{ o.full }})</option>{% endfor %}</optgroup>{% endif %}
    </select>
    <select class="tb-select" data-key="brand" aria-label="{{ T.brand }}">
      <option value="">{{ T.allBrands }}</option>
      {%- for b in D.brands %}{% if b.products.length %}<option value="{{ b.slug }}">{{ b.name }}</option>{% endif %}{% endfor %}
    </select>
    {%- if D.appCounts.length %}
    <select class="tb-select" data-key="app" aria-label="{{ T.byApp }}">
      <option value="">{{ T.allApps }}</option>
      {%- for a in D.appCounts %}<option value="{{ a.key }}">{{ a.label }}</option>{% endfor %}
    </select>
    {%- endif %}
    <select class="tb-select" data-key="ref" aria-label="{{ T.refrigerant }}">
      <option value="">{{ T.allGrades }}</option>
      {%- for r in D.refrigerants %}{% if r.products.length %}<option value="{{ r.slug }}">{{ r.number }}</option>{% endif %}{% endfor %}
    </select>
    <button type="button" class="tb-reset" id="reset" hidden>✕ {{ T.clearFilters }}</button>
    <div class="view-toggle" role="group" aria-label="{{ T.viewMode }}">
      <button type="button" data-view="cards" class="active" aria-pressed="true" title="{{ T.viewCards }}">{{ icon("cards") }}<span class="sr-only">{{ T.viewCards }}</span></button>
      <button type="button" data-view="table" aria-pressed="false" title="{{ T.viewTable }}">{{ icon("list") }}<span class="sr-only">{{ T.viewTable }}</span></button>
    </div>
  </div>
</div></section>

<section style="padding-bottom:64px"><div class="container">
  <div class="count" id="count" data-tpl="{{ T.showing }} {n} {{ T.items }}">{{ T.showing }} {{ D.products.length }} {{ T.items }}</div>
  <div class="prod-grid" id="grid">
    {%- for p in D.productsAZ %}{{ productCard(p, lang, T) }}{% endfor %}
  </div>
  <div class="table-wrap" id="tableView" hidden>
    <table class="data-table prod-table" id="mainTable">
      <thead><tr>
        <th>{{ T.products }}</th><th>{{ T.brand }}</th><th>{{ T.refrigerant }}</th><th>{{ T.type }}</th><th>ASHRAE</th><th>{{ T.gwp }}</th><th>{{ T.packages }}</th><th></th>
      </tr></thead>
      <tbody>
        {%- for p in D.productsAZ %}
        {%- set href = ('/products/' ~ p.slug ~ '/') | u(lang) %}
        <tr class="prod-row" data-labels="{{ p.tags | join(' ') }}" data-class="{{ p.kind }}" data-brand="{{ p.brand }}" data-ref="{{ p.refrigerant }}" data-app="{{ p.appKeys }}" data-cat="{{ p.category }}" data-text="{{ p.searchText }}">
          <td>
            <a class="pt-name" href="{{ href }}"><span class="dot" style="background:{{ p.ref.color if p.ref else '#2F3192' }}"></span>{{ p.name }}</a>
            {%- if p.tags.length %}<div class="pt-tags">{% for l in p.tags %}{{ tagBadge(l, T) }}{% endfor %}</div>{% endif %}
          </td>
          <td>{{ p.brandObj.name if p.brandObj }}</td>
          <td><strong>{{ p.ref.number if p.ref }}</strong></td>
          <td>{{ p.kind }}</td>
          <td>{% if p.ref %}<span class="chip sfc sf-{{ p.ref.safety }}">{{ p.ref.safety }}</span>{% endif %}</td>
          <td>{% if p.ref %}<span class="gwp-bar" style="--w:{{ p.ref.gwp_ar4 | gwpBar }}%"></span>{{ p.ref.gwp_ar4 }}{% endif %}</td>
          <td class="muted">{% if p.packages and p.packages.length %}{{ p.packShort }}{% else %}{{ T.askSizesHi }}{% endif %}</td>
          <td><a class="pt-go" href="{{ href }}">{{ T.viewDetails }} →</a></td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    {#- shown instead of the table above while the category filter is "oil" (assets/js/products.js) -#}
    <table class="data-table prod-table oil-table" id="oilTable" hidden>
      <thead><tr>
        <th>{{ T.products }}</th><th>{{ T.oilTypeCol }}</th><th>{{ T.viscGrade }}</th><th>{{ T.visc40 }}</th><th>{{ T.visc100 }}</th><th>VI</th><th>{{ T.usedFor }}</th><th>{{ T.packages }}</th><th></th>
      </tr></thead>
      <tbody>
        {%- for p in D.productsAZ %}{% if p.category == "oil" %}
        {%- set href = ('/products/' ~ p.slug ~ '/') | u(lang) %}
        <tr class="prod-row" data-labels="{{ p.tags | join(' ') }}" data-class="{{ p.kind }}" data-brand="{{ p.brand }}" data-ref="" data-app="{{ p.appKeys }}" data-cat="oil" data-text="{{ p.searchText }}">
          <td><a class="pt-name" href="{{ href }}"><span class="dot ot-{{ p.oilType }}"></span>{{ p.name }}</a></td>
          <td><span class="ot-badge ot-{{ p.oilType }}">{{ p.oilType }}</span></td>
          <td class="num">{{ p.oilGrade or "—" }}</td>
          <td class="num">{{ p.oilData.v40 or "—" }}</td>
          <td class="num">{{ p.oilData.v100 or "—" }}</td>
          <td class="num">{{ p.oilData.vi or "—" }}</td>
          <td>{{ T.oilUse[p.oilType] }}</td>
          <td class="muted">{% if p.packages and p.packages.length %}{{ p.packShort }}{% else %}{{ T.askSizesHi }}{% endif %}</td>
          <td><a class="pt-go" href="{{ href }}">{{ T.viewDetails }} →</a></td>
        </tr>
        {%- endif %}{% endfor %}
      </tbody>
    </table>
  </div>
  <div class="card empty" id="empty" {% if D.products.length %}hidden{% endif %}>
    {{ T.noResults if D.products.length else T.comingSoon }}
    <div style="margin-top:16px"><a class="btn btn-ghost" href="{{ '/contact/' | u(lang) }}">{{ T.contactSales }}</a></div>
  </div>
</div></section>
