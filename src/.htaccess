# ORAFON — Apache settings (Plesk). Deployed from the build output.

ErrorDocument 404 /404.html
Options -Indexes

# Old prototype URLs -> new pages
Redirect 301 /shop.html /products/
Redirect 301 /orafon-n40-shop-corporate.html /products/solstice-n40/
Redirect 301 /about.html /about/
Redirect 301 /contact.html /contact/

# Force HTTPS (Plesk's own redirect setting also works; this is a fallback)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Brands index merged into About (brand detail pages /brands/<name>/ still exist)
  RewriteRule ^brands/?$ /about/#brands [R=301,NE,L]
  RewriteRule ^en/brands/?$ /en/about/#brands [R=301,NE,L]

  # Refrigerant data pages were removed -> products filtered by that grade
  RewriteRule ^refrigerants/?$ /products/ [R=301,L]
  RewriteRule ^en/refrigerants/?$ /en/products/ [R=301,L]
  RewriteRule ^refrigerants/([a-z0-9-]+)/?$ /products/?ref=$1 [R=301,L]
  RewriteRule ^en/refrigerants/([a-z0-9-]+)/?$ /en/products/?ref=$1 [R=301,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Caching: assets long, HTML short (content changes on every deploy)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
