---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/about/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /about/
section: about
eleventyComputed:
  title: "{{ i18n[lang].about }}"
  description: "{{ db[lang].about.lead }}"
---
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set A = D.about -%}
<div class="container"><nav class="breadcrumb" aria-label="breadcrumb"><a href="{{ '/' | u(lang) }}">{{ D.site.brand_name }}</a><span>›</span>{{ T.about }}</nav></div>
<section class="ab-hero"><div class="container">
  <h1 class="display">{{ A.title }} <span class="grad-text">{{ A.highlight }}</span></h1>
  <p class="lead" style="font-size:18px;color:var(--text-muted);max-width:65ch;margin-top:18px;line-height:1.8">{{ A.lead }}</p>
  <p style="margin-top:12px;font-weight:600">{{ D.site.company_name }}</p>
</div></section>
{%- if A.cards and A.cards.length %}
<section class="section" style="padding-top:20px"><div class="container">
  <div class="ab-grid">
    {%- for c in A.cards %}<div class="ab-card"><h3>{{ c.title }}</h3><p>{{ c.text }}</p></div>{% endfor %}
  </div>
</div></section>
{%- endif %}
{%- if A.body %}
<section class="section" style="padding-top:0"><div class="container"><div class="prose">{{ A.body | md | safe }}</div></div></section>
{%- endif %}
<section class="section" id="brands" style="padding-top:0"><div class="container">
  <h2 class="display">{{ T.ourBrands }}</h2>
  <div class="brand-panels">
    {%- for b in D.brands %}
    <article class="brand-panel {{ 'own' if b.own_brand else 'dist' }}">
      <div class="bp-side">
        <span class="bp-logo">{% if b.logo %}<img src="{{ b.logo }}" alt="{{ b.name }}">{% else %}{{ b.name }}{% endif %}</span>
        <span class="chip {{ 'i' if b.own_brand else 'v' }}">{{ T.ownBrand if b.own_brand else T.distributor }}</span>
        <div class="bp-count"><b>{{ b.products.length }}</b> {{ T.items }}</div>
      </div>
      <div class="bp-body">
        <h3>{{ b.name }}</h3>
        <p class="bp-tag">{{ b.tagline }}</p>
        <div class="prose muted">{{ b.description | md | safe }}</div>
        {%- if b.products.length %}
        <div class="bp-grades">
          {%- for p in b.products %}<a class="grade-mini" href="{{ ('/products/' ~ p.slug ~ '/') | u(lang) }}" style="--c:{{ p.ref.color if p.ref else '#4F46E5' }}">{{ p.ref.number if p.ref else p.name }}</a>{% endfor %}
        </div>
        {%- endif %}
        <a class="btn btn-ghost" href="{{ ('/brands/' ~ b.slug ~ '/') | u(lang) }}">{{ T.brandPage }} {{ b.name }} →</a>
      </div>
    </article>
    {%- endfor %}
  </div>
</div></section>
