---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ '/retrofit/' | u(lang) }}"
layout: layouts/base.njk
pathKey: /retrofit/
section: technical
pageScript: filter.js
eleventyComputed:
  title: "{{ i18n[lang].retrofit }} — {{ i18n[lang].technical }}"
  description: "{{ i18n[lang].retrofitLead }}"
---
{#- Built from each refrigerant's "replaces" list: old refrigerant -> the grades that replace it -#}
{%- set T = i18n[lang] -%}
{%- set D = db[lang] -%}
{%- set techTab = "retrofit" -%}
{%- set techTitle = T.retrofit -%}
{%- set techLead = T.retrofitLead -%}
{%- set olds = [] -%}
{%- for r in D.refrigerants %}{% for x in r.replaces %}{% if x not in olds %}{% set olds = olds.concat([x]) %}{% endif %}{% endfor %}{% endfor -%}
{% include "partials/tech-head.njk" %}

<section class="section" style="padding-top:28px" data-filter><div class="container">
  <div class="filter-bar" style="margin-top:0">
    <div class="filter-row"><input class="q-input" type="search" data-f-search placeholder="{{ T.searchGrade }}" aria-label="{{ T.search }}"></div>
  </div>
  <div class="count" data-f-count data-tpl="{{ T.showing }} {n} {{ T.items }}"></div>

  <div class="retro-list">
    {%- for old in olds | sort %}
    {%- set oldRef = null %}{% for r in D.refrigerants %}{% if r.number == old %}{% set oldRef = r %}{% endif %}{% endfor %}
    {%- set alts = [] %}{% for r in D.refrigerants %}{% if old in r.replaces %}{% set alts = alts.concat([r]) %}{% endif %}{% endfor %}
    <div class="retro-row" data-f-item data-text="{{ (old ~ ' ' ~ (alts | join(' ', 'number'))) | lower }}">
      <div class="retro-old">
        <span class="ro-label">{{ T.oldRef }}</span>
        {%- if oldRef and oldRef.products.length %}<a class="ro-num" href="{{ oldRef.url | u(lang) }}">{{ old }}</a>
        {%- else %}<span class="ro-num">{{ old }}</span>{% endif %}
        {%- if oldRef %}<span class="ro-meta">{{ oldRef.class }} · GWP {{ oldRef.gwp_ar4 }}</span>{% endif %}
        {%- if oldRef and oldRef.products.length == 1 %}<a class="ro-prod" href="{{ oldRef.url | u(lang) }}">{{ oldRef.products[0].name }} →</a>{% endif %}
      </div>
      <div class="retro-arrow" aria-hidden="true">→</div>
      <div class="retro-alts">
        {%- for r in alts %}
        {%- set save = (oldRef.gwp_ar4 | gwpSaving(r.gwp_ar4)) if oldRef else 0 %}
        {%- set altHref = (r.url | u(lang)) if r.products.length else (('/contact/' | u(lang)) ~ '?product=' ~ (r.number | urlencode)) %}
        <a class="alt-card{% if not r.products.length %} no-prod{% endif %}" href="{{ altHref }}" style="--c:{{ r.color or '#1F3F9F' }}">
          <span class="ac-top"><b>{{ r.number }}</b><span class="chip sfc sf-{{ r.safety }}">{{ r.safety }}</span></span>
          <span class="ac-meta">{{ r.class }} · GWP {{ r.gwp_ar4 }}</span>
          {%- if save >= 10 %}<span class="ac-save">−{{ save }}% GWP</span>{% endif %}
          {%- if r.products.length == 1 %}<span class="ac-prod">{{ r.products[0].name }} →</span>
          {%- elif r.products.length > 1 %}<span class="ac-prod">{{ r.products.length }} {{ T.items }} →</span>
          {%- else %}<span class="ac-prod muted">{{ T.requestQuote }} →</span>{% endif %}
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
  <div class="card empty" data-f-empty hidden>{{ T.noResults }}</div>
  <p class="note">{{ T.dataNote }}</p>
</div></section>
